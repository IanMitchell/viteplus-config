{
	"name": "@0x57/viteplus-config",
	"version": "0.1.0",
	"description": "Shared Vite+ configuration used by 0x57 projects",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IanMitchell/viteplus-config.git"
	},
	"files": [
		"dist",
		"typescript"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./oxfmt": {
			"types": "./dist/oxfmt/index.d.ts",
			"default": "./dist/oxfmt/index.js"
		},
		"./oxlint": {
			"types": "./dist/oxlint/index.d.ts",
			"default": "./dist/oxlint/index.js"
		},
		"./oxlint/next": {
			"types": "./dist/oxlint/next.d.ts",
			"default": "./dist/oxlint/next.js"
		},
		"./typescript/base.json": "./typescript/base.json",
		"./typescript/browser.json": "./typescript/browser.json",
		"./typescript/library.json": "./typescript/library.json",
		"./typescript/nextjs.json": "./typescript/nextjs.json",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "vp pack"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"@types/semver": "7.8.0",
		"semver": "7.8.5",
		"typescript": "7.0.2",
		"valibot": "1.4.2",
		"vite-plus": "0.2.8"
	},
	"peerDependencies": {
		"vite-plus": "0.2.8"
	},
	"packageManager": "bun@1.3.14"
}
